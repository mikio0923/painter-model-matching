# ============================================================
# 本番環境設定テンプレート
# デプロイ時にこのファイルを .env にリネームし、
# 各 "CHANGE_ME" を実際の値に置き換えてください
# ============================================================

APP_NAME=Palette
APP_ENV=production
APP_KEY=CHANGE_ME_GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://CHANGE_ME_YOUR_DOMAIN.com

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ─────────────────────────────────────────
# ログ設定
# ─────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ─────────────────────────────────────────
# データベース設定
# ─────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=CHANGE_ME_DB_HOST
DB_PORT=3306
DB_DATABASE=CHANGE_ME_DB_NAME
DB_USERNAME=CHANGE_ME_DB_USER
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# ─────────────────────────────────────────
# セッション設定
# ─────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=CHANGE_ME_YOUR_DOMAIN.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ─────────────────────────────────────────
# キュー・キャッシュ・ファイルシステム
# ─────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─────────────────────────────────────────
# メール設定（Amazon SES 推奨）
# ─────────────────────────────────────────
MAIL_MAILER=ses
MAIL_FROM_ADDRESS=noreply@CHANGE_ME_YOUR_DOMAIN.com
MAIL_FROM_NAME="${APP_NAME}"

# SES以外（SendGrid等）を使う場合：
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=CHANGE_ME_SENDGRID_API_KEY
# MAIL_ENCRYPTION=tls

# ─────────────────────────────────────────
# AWS設定（SES・S3を利用する場合）
# ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=CHANGE_ME

# ─────────────────────────────────────────
# Sentry（エラー監視）
# ─────────────────────────────────────────
SENTRY_LARAVEL_DSN=https://CHANGE_ME@xxx.ingest.sentry.io/CHANGE_ME
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─────────────────────────────────────────
# Laravel Telescope（本番では無効化）
# ─────────────────────────────────────────
TELESCOPE_ENABLED=false

# ─────────────────────────────────────────
# Vite
# ─────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
